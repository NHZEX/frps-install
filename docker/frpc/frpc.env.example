# * 复制为 .env 后按实际环境填写。
FRP_SERVER_ADDR=frps.example.com
FRP_SERVER_PORT=7100
FRP_AUTH_TOKEN=CHANGE_ME

FRP_LOG_LEVEL=info

FRPC_WEB_ADDR=127.0.0.1
FRPC_WEB_PORT=7400
FRPC_WEB_USER=admin
FRPC_WEB_PASSWORD=CHANGE_ME
FRPC_WEB_PPROF_ENABLE=false

# * 可选：仅在你启用 natHoleStunServer 配置时需要。
FRP_NAT_HOLE_STUN_SERVER=
